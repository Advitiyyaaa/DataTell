# ── Core ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Turso Cloud (cloud SQLite) ─────────────────────────────────────────────────
# Sign up at https://turso.tech, create a database, then run:
#   python scripts/migrate_to_turso.py
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Chroma Cloud (cloud vector store) ─────────────────────────────────────────
# Sign up at https://trychroma.com, then run:
#   python scripts/migrate_to_chroma_cloud.py
CHROMA_TENANT=your-tenant-id
CHROMA_DATABASE=datatell
CHROMA_API_KEY=your-chroma-api-key

# ── Mode switches ──────────────────────────────────────────────────────────────
# Set these to "true" / "cloud" to use cloud services.
# Leave as "false" / "local" to run fully offline.
USE_TURSO=false
CHROMA_MODE=local
